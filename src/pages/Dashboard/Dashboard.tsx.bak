import { useEffect, useState } from "react";
import { LineChart } from "../../components/charts/LineChart";
import { BarChart } from "../../components/charts/BarChart";
import { Donut } from "../../components/charts/Donut";
import { getSummary, Summary, TradeRDetail } from "../../lib/analyticsApi";
import { getRiskStatus, RiskStatus } from "../../lib/riskSettingsApi";
import { getPropFirmStatus, PropFirmStatus } from "../../lib/propFirmApi";
import { getActiveAccountId } from "../../lib/accountsApi";
import { HelpTip } from "../../components/ui/HelpTip";
import { getGoals, AccountGoals } from "../../lib/goalsApi";
import "./Dashboard.css";

// ============================================================
// Formatters
// ============================================================
const fmtMoney = (v: string, currency = "$") => {
  const n = Number(v);
  return Number.isFinite(n)
    ? `${currency}${n.toLocaleString(undefined, { maximumFractionDigits: 2 })}`
    : v;
};

const fmtPct = (v: string) => {
  const n = Number(v);
  return Number.isFinite(n) ? `${n.toFixed(1)}%` : v;
};

const fmtR = (v: string) => {
  const n = Number(v);
  return Number.isFinite(n) ? `${n >= 0 ? "+" : ""}${n.toFixed(2)}R` : v;
};

const fmtAgo = (iso: string) => {
  if (!iso) return "—";
  const diff = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return "just now";
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  return `${Math.floor(hrs / 24)}d ago`;
};

// ============================================================
// Main Dashboard
// ============================================================
export function Dashboard() {
  const [s, setS] = useState<Summary | null>(null);
  const [risk, setRisk] = useState<RiskStatus | null>(null);
  const [pf, setPf] = useState<PropFirmStatus | null>(null);
  const [goals, setGoals] = useState<AccountGoals | null>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function load() {
    setError(null);
    try {
      const summary = await getSummary();
      setS(summary);
      const accId = await getActiveAccountId();
      try { setRisk(await getRiskStatus(accId)); } catch { setRisk(null); }
      try { setPf(await getPropFirmStatus(accId)); } catch { setPf(null); }
      try { setGoals(await getGoals(accId)); } catch { setGoals(null); }
    } catch (e) {
      setError(String(e));
    }
  }

  useEffect(() => {
    (async () => {
      setLoading(true);
      await load();
      setLoading(false);
    })();
  }, []);

  async function refresh() {
    setRefreshing(true);
    await load();
    setRefreshing(false);
  }

  if (loading) {
    return (
      <div className="dash">
        <DashSkeleton />
      </div>
    );
  }

  if (error) {
    return (
      <div className="dash">
        <div className="dash-error">
          <div className="dash-error__icon">⚠</div>
          <div className="dash-error__title">Could not load dashboard</div>
          <div className="dash-error__msg">{error}</div>
          <button className="btn btn--primary" onClick={refresh}>
            Try again
          </button>
        </div>
      </div>
    );
  }

  if (!s) {
    return (
      <div className="dash">
        <div className="dash-empty">
          <div className="dash-empty__icon">▦</div>
          <div className="dash-empty__title">No data yet</div>
          <div className="dash-empty__hint">Add trades in the Journal to see your stats here.</div>
        </div>
      </div>
    );
  }

  const equitySeries = s.equity_curve.map((p) => ({ t: p.t, v: Number(p.v) }));
  const drawdownSeries = s.drawdown_curve.map((p) => ({ t: p.t, v: Number(p.v) }));
  const rBars = s.r_distribution.map((b) => ({ label: b.label.replace("R", ""), v: b.count }));
  const hasTrades = s.closed_trades > 0;
  const pnlPositive = Number(s.net_pnl) >= 0;

  return (
    <div className="dash">
      {/* Header */}
      <div className="dash__header">
        <div>
          <h1 className="dash__title">Dashboard</h1>
          <p className="dash__subtitle">
            Live overview · {s.total_trades} trade{s.total_trades === 1 ? "" : "s"}
            {s.open_trades > 0 && ` · ${s.open_trades} open`}
          </p>
        </div>
        <button
          className={`dash__refresh ${refreshing ? "is-refreshing" : ""}`}
          onClick={refresh}
          disabled={refreshing}
        >
          <span className="dash__refresh-icon">↻</span>
          <span>{refreshing ? "Refreshing…" : "Refresh"}</span>
        </button>
      </div>

      {/* KPI Row */}
      <section className="dash__grid">
        <KpiCard
          label="Balance"
          value={fmtMoney(s.current_equity)}
          hint={`Initial ${fmtMoney(s.initial_balance)}`}
          tone="accent"
          help="Current equity = initial balance + all closed P&L."
        />
        <KpiCard
          label="Net P&L"
          value={fmtMoney(s.net_pnl)}
          hint={hasTrades ? `${s.closed_trades} closed trades` : "No closed trades"}
          tone={pnlPositive ? "success" : "danger"}
          trend={pnlPositive ? "up" : "down"}
          help="Sum of all realized P&L on closed trades."
        />
        <KpiCard
          label="Win Rate"
          value={hasTrades ? fmtPct(s.win_rate_pct) : "—"}
          hint={hasTrades ? `${s.wins}W / ${s.losses}L` : "No results yet"}
          help="Percentage of winning trades out of all decided trades."
        />
        <KpiCard
          label="Open Positions"
          value={String(s.open_trades)}
          hint={s.open_trades === 0 ? "No open trades" : "Currently running"}
          help="Number of trades still open."
        />
      </section>

      {/* Equity + Drawdown */}
      <section className="dash__row dash__row--2">
        <div className="card">
          <div className="card__head">
            <h3>Equity Curve</h3>
            <span className="card__badge">{s.closed_trades} trades</span>
          </div>
          {equitySeries.length > 1 ? (
            <LineChart
              data={equitySeries}
              formatY={(v) => `$${Math.round(v).toLocaleString()}`}
              height={240}
            />
          ) : (
            <div className="dash__placeholder">
              Equity curve will appear after you close your first trade.
            </div>
          )}
        </div>

        <div className="card">
          <div className="card__head">
            <h3>Drawdown</h3>
            <span className="card__badge">max {fmtPct(s.max_drawdown_pct)}</span>
          </div>
          {drawdownSeries.length > 1 ? (
            <LineChart
              data={drawdownSeries}
              color="var(--danger)"
              formatY={(v) => `${v.toFixed(1)}%`}
              height={240}
            />
          ) : (
            <div className="dash__placeholder">
              Drawdown will be shown once you have trades.
            </div>
          )}
        </div>
      </section>

      {/* Performance Row */}
      <section className="dash__row dash__row--3">
        <div className="card">
          <div className="card__head">
            <h3>R-Multiple Distribution</h3>
            <HelpTip title="R-Multiple">
              R measures how many times your initial risk you made or lost per trade.
              +2R = made twice the risk. -1R = full stop loss.
            </HelpTip>
          </div>
          {rBars.some((b) => b.v > 0) ? (
            <BarChart data={rBars} height={180} />
          ) : (
            <div className="dash__placeholder">No R data yet.</div>
          )}
        </div>

        <div className="card">
          <div className="card__head">
            <h3>Win / Loss</h3>
            <HelpTip title="Win Rate">
              Number of winning trades vs losing trades (excluding breakeven).
            </HelpTip>
          </div>
          {s.wins + s.losses > 0 ? (
            <Donut wins={s.wins} losses={s.losses} />
          ) : (
            <div className="dash__placeholder">No results yet.</div>
          )}
        </div>

        <div className="card">
          <div className="card__head">
            <h3>Key Stats</h3>
            <HelpTip title="Key Metrics">
              Profit Factor = gross profit / gross loss. Expectancy = average R per trade.
            </HelpTip>
          </div>
          <ul className="risk-list">
            <li>
              <span>Profit factor</span>
              <span className="mono">{Number(s.profit_factor).toFixed(2)}</span>
            </li>
            <li>
              <span>Expectancy</span>
              <span className={`mono ${Number(s.expectancy_r) >= 0 ? "pos" : "neg"}`}>
                {fmtR(s.expectancy_r)}
              </span>
            </li>
            <li>
              <span>Avg win</span>
              <span className="mono pos">{fmtR(s.avg_win_r)}</span>
            </li>
            <li>
              <span>Avg loss</span>
              <span className="mono neg">{fmtR(s.avg_loss_r)}</span>
            </li>
          </ul>
        </div>
      </section>

      {/* KPI Strip */}
      <section className="card kpi-strip">
        <Kpi label="Total Trades" value={String(s.total_trades)} />
        <Kpi label="Closed" value={String(s.closed_trades)} />
        <Kpi label="Wins" value={String(s.wins)} tone="success" />
        <Kpi label="Losses" value={String(s.losses)} tone="danger" />
        <Kpi label="Gross Profit" value={fmtMoney(s.gross_profit)} tone="success" />
        <Kpi label="Gross Loss" value={fmtMoney(`-${s.gross_loss}`)} tone="danger" />
      </section>

      {/* Risk Budget */}
      {risk && (
        <section className="card">
          <div className="card__head">
            <h3>Risk Budget</h3>
            <span className={`card__badge ${risk.max_positions_hit || risk.daily_loss_limit_hit || risk.portfolio_risk_exceeded ? "bad" : "ok"}`}>
              {risk.max_positions_hit || risk.daily_loss_limit_hit || risk.portfolio_risk_exceeded
                ? "⚠ limits hit"
                : "within limits"}
            </span>
          </div>

          <div className="risk-budget-grid">
            <RiskBar
              label="Portfolio risk"
              value={Number(risk.open_risk_pct)}
              limit={Number(risk.settings.max_portfolio_risk_pct)}
              unit="%"
            />
            <RiskBar
              label="Daily loss"
              value={Number(risk.daily_loss_pct)}
              limit={Number(risk.settings.daily_loss_limit_pct)}
              unit="%"
            />
            <RiskBar
              label="Open positions"
              value={risk.open_positions}
              limit={risk.settings.max_open_positions}
              unit=""
            />
          </div>

          {risk.warnings.length > 0 && (
            <ul className="risk-warnings">
              {risk.warnings.map((w, i) => <li key={i}>⚠ {w}</li>)}
            </ul>
          )}
        </section>
      )}

      {/* Prop-firm Rules */}
      {pf && pf.rules.enabled && (
        <section className="card">
          <div className="card__head">
            <h3>Prop-firm Rules</h3>
            <span className={`card__badge ${pf.all_passed ? "ok" : "bad"}`}>
              {pf.all_passed ? "all passed" : "⚠ breach"}
            </span>
          </div>

          <div className="propfirm-grid">
            {pf.checks.map((c) => (
              <div key={c.name} className={`pf-check ${c.passed ? "is-pass" : "is-fail"}`}>
                <div className="pf-check__head">
                  <span className="pf-check__name">{c.name}</span>
                  <span className={`pf-check__status ${c.passed ? "ok" : "bad"}`}>
                    {c.passed ? "✓" : "✕"}
                  </span>
                </div>
                <div className="pf-check__msg">{c.message}</div>
              </div>
            ))}
          </div>

          <div className="pf-summary mono">
            Peak {Number(pf.peak_equity).toLocaleString()} ·
            Current {Number(pf.current_equity).toLocaleString()} ·
            P&L {Number(pf.total_pnl) >= 0 ? "+" : ""}{Number(pf.total_pnl).toLocaleString()} ·
            Trading days {pf.trading_days}
          </div>
        </section>
      )}

      {/* Goals + Motivation */}
      <section className="dash__row dash__row--2">
        {goals && (
          <GoalsCard
            goals={goals}
            netPnl={s.net_pnl}
            initialBalance={s.initial_balance}
          />
        )}
        <MotivationCard
          netPnl={s.net_pnl}
          winRate={s.win_rate_pct}
          closedTrades={s.closed_trades}
        />
      </section>

      {/* Time-of-Day Performance */}
      <TimeOfDayCard trades={s.r_details} />

      {/* Recent Trades */}
      <section className="card">
        <div className="card__head">
          <h3>Recent Closed Trades</h3>
          <span className="card__badge">{Math.min(5, s.r_details.length)} shown</span>
        </div>
        {s.r_details.length === 0 ? (
          <div className="dash__placeholder">
            Your closed trades will appear here once you complete your first trade.
          </div>
        ) : (
          <table className="trades">
            <thead>
              <tr>
                <th>ID</th>
                <th>Symbol</th>
                <th>Side</th>
                <th>R</th>
                <th>P&L</th>
                <th>Closed</th>
              </tr>
            </thead>
            <tbody>
              {[...s.r_details].reverse().slice(0, 5).map((t: TradeRDetail) => (
                <tr key={t.id}>
                  <td className="mono dim">{t.id}</td>
                  <td className="mono">{t.symbol}</td>
                  <td className={t.side === "long" ? "side-long" : "side-short"}>
                    {t.side}
                  </td>
                  <td className={`mono ${Number(t.r_multiple) >= 0 ? "pos" : "neg"}`}>
                    {fmtR(t.r_multiple)}
                  </td>
                  <td className={`mono ${Number(t.net_pnl) >= 0 ? "pos" : "neg"}`}>
                    {fmtMoney(t.net_pnl)}
                  </td>
                  <td className="mono dim" title={t.closed_at}>
                    {fmtAgo(t.closed_at)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    </div>
  );
}

// ============================================================
// Sub-components
// ============================================================
function KpiCard({ label, value, hint, tone, trend, help }: {
  label: string;
  value: string;
  hint?: string;
  tone?: "accent" | "success" | "danger";
  trend?: "up" | "down";
  help?: string;
}) {
  const toneClass = tone ? `stat__value--${tone}` : "";
  return (
    <div className="card stat">
      <div className="stat__head">
        <span className="stat__label">{label}</span>
        {help && <HelpTip title={label}>{help}</HelpTip>}
      </div>
      <div className="stat__row">
        <span className={`stat__value ${toneClass} mono`}>{value}</span>
        {trend && (
          <span className={`stat__trend stat__trend--${trend}`}>
            {trend === "up" ? "↑" : "↓"}
          </span>
        )}
      </div>
      {hint && <span className="stat__hint">{hint}</span>}
    </div>
  );
}

function Kpi({ label, value, tone }: {
  label: string;
  value: string;
  tone?: "success" | "danger";
}) {
  const toneClass = tone ? `kpi__value--${tone}` : "";
  return (
    <div className="kpi">
      <span className="kpi__label">{label}</span>
      <span className={`kpi__value ${toneClass} mono`}>{value}</span>
    </div>
  );
}

function RiskBar({ label, value, limit, unit }: {
  label: string;
  value: number;
  limit: number;
  unit: string;
}) {
  const pct = limit > 0 ? Math.min(100, (value / limit) * 100) : 0;
  const danger = pct >= 100;
  const warn = pct >= 75 && !danger;
  const tone = danger ? "var(--danger)" : warn ? "var(--warning)" : "var(--accent)";
  const fmt = (v: number) => unit === "%" ? v.toFixed(2) : String(v);
  return (
    <div className="risk-bar">
      <div className="risk-bar__head">
        <span>{label}</span>
        <span className={`mono ${danger ? "neg" : warn ? "" : "pos"}`}>
          {fmt(value)}{unit} / {fmt(limit)}{unit}
        </span>
      </div>
      <div className="risk-bar__track">
        <div className="risk-bar__fill" style={{ width: `${pct}%`, background: tone }} />
      </div>
    </div>
  );
}

// ============================================================
// Skeleton Loader
// ============================================================
function DashSkeleton() {
  return (
    <>
      <div className="dash__header">
        <div>
          <div className="skeleton skeleton-line" style={{ width: 200, height: 24 }} />
          <div className="skeleton skeleton-line" style={{ width: 300, height: 12, marginTop: 8 }} />
        </div>
      </div>
      <section className="dash__grid">
        {[1, 2, 3, 4].map((i) => (
          <div key={i} className="card">
            <div className="skeleton skeleton-line" style={{ width: "50%", height: 12 }} />
            <div className="skeleton skeleton-line" style={{ width: "70%", height: 24, marginTop: 10 }} />
            <div className="skeleton skeleton-line" style={{ width: "40%", height: 10, marginTop: 6 }} />
          </div>
        ))}
      </section>
      <section className="dash__row dash__row--2">
        <div className="card">
          <div className="skeleton skeleton-line" style={{ width: "30%", height: 14 }} />
          <div className="skeleton skeleton-block" style={{ marginTop: 14, height: 220 }} />
        </div>
        <div className="card">
          <div className="skeleton skeleton-line" style={{ width: "30%", height: 14 }} />
          <div className="skeleton skeleton-block" style={{ marginTop: 14, height: 220 }} />
        </div>
      </section>
    </>
  );
}


// ============================================================
// Goals Card
// ============================================================
function GoalsCard({ goals, netPnl, initialBalance }: {
  goals: AccountGoals;
  netPnl: string;
  initialBalance: string;
}) {
  const pnl = Number(netPnl);
  const bal = Number(initialBalance);
  const pnlPct = bal > 0 ? (pnl / bal) * 100 : 0;

  const dailyTarget = Number(goals.daily_target_pct);
  const weeklyTarget = Number(goals.weekly_target_pct);
  const monthlyTarget = Number(goals.monthly_target_pct);

  // Estimate progress: pnlPct vs monthly target (rough)
  const monthlyProgress = monthlyTarget > 0 ? (pnlPct / monthlyTarget) * 100 : 0;

  const bars = [
    { label: "Daily", target: dailyTarget, value: pnlPct, period: "today" },
    { label: "Weekly", target: weeklyTarget, value: pnlPct, period: "this week" },
    { label: "Monthly", target: monthlyTarget, value: pnlPct, period: "this month" },
  ];

  return (
    <div className="card">
      <div className="card__head">
        <h3>Goals</h3>
        <span className="card__badge">{monthlyProgress > 0 ? `${monthlyProgress.toFixed(0)}%` : "0%"} of monthly</span>
      </div>

      <div className="goals-list">
        {bars.map((b) => {
          const pct = b.target > 0 ? Math.min(100, Math.max(0, (b.value / b.target) * 100)) : 0;
          const done = pct >= 100;
          const positive = b.value >= 0;
          return (
            <div key={b.label} className="goal-bar">
              <div className="goal-bar__head">
                <span className="goal-bar__label">{b.label} target</span>
                <span className={`mono ${positive ? "pos" : "neg"}`}>
                  {positive ? "+" : ""}{b.value.toFixed(2)}% / {b.target}%
                </span>
              </div>
              <div className="goal-bar__track">
                <div
                  className={`goal-bar__fill ${done ? "is-done" : ""} ${!positive ? "is-negative" : ""}`}
                  style={{ width: `${pct}%` }}
                />
              </div>
              <div className="goal-bar__hint">
                {done ? "✓ Target reached" : `${pct.toFixed(0)}% toward ${b.period} target`}
              </div>
            </div>
          );
        })}
      </div>

      <p className="goal-note">
        Edit targets in <strong>Accounts → Risk</strong>.
      </p>
    </div>
  );
}

// ============================================================
// Motivation Card
// ============================================================
const MOTIVATION_MESSAGES = [
  { min: 1000, msg: "Outstanding. You are in the top tier of discipline.", emoji: "🔥" },
  { min: 500, msg: "Strong performance. Consistency is your edge.", emoji: "💎" },
  { min: 200, msg: "Great work. Keep following your plan.", emoji: "✨" },
  { min: 50, msg: "Positive territory. Stay patient, stay focused.", emoji: "🌟" },
  { min: 1, msg: "You are green. Trust your process.", emoji: "👍" },
  { min: -50, msg: "Small drawdown. Review, don't react. Next trade will be different.", emoji: "💪" },
  { min: -200, msg: "Rough patch. Focus on the checklist, not the P&L.", emoji: "🎯" },
  { min: -500, msg: "Protect your capital. Reduce size, rebuild confidence.", emoji: "🛡️" },
  { min: -1000, msg: "Step back. A losing streak is not a losing trader.", emoji: "🧘" },
  { min: -999999, msg: "Stop. Breathe. Come back tomorrow with a clear mind.", emoji: "🔄" },
];

function MotivationCard({ netPnl, winRate, closedTrades }: {
  netPnl: string;
  winRate: string;
  closedTrades: number;
}) {
  const pnl = Number(netPnl);
  const wr = Number(winRate);

  const [customText, setCustomText] = useState<string>(() => {
    try { return localStorage.getItem("motivation.custom") || ""; } catch { return ""; }
  });
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(customText);
  const [fullscreen, setFullscreen] = useState(false);
  const [duration, setDuration] = useState<5 | 10>(5);

  const message = MOTIVATION_MESSAGES.find((m) => pnl >= m.min);

  let subline = "";
  if (closedTrades === 0) subline = "Start with your first trade.";
  else if (wr >= 60) subline = "High win rate — protect it with discipline.";
  else if (wr >= 40) subline = "Balanced. Focus on R:R, not just wins.";
  else subline = "Win rate is low — but expectancy matters more than win rate.";

  const displayedText = customText.trim() || message?.msg || "Keep going.";
  const displayedEmoji = customText.trim() ? "◆" : (message?.emoji || "•");

  function saveCustom() {
    const v = draft.trim();
    setCustomText(v);
    try { localStorage.setItem("motivation.custom", v); } catch { /* ignore */ }
    setEditing(false);
  }

  function clearCustom() {
    setCustomText("");
    setDraft("");
    try { localStorage.removeItem("motivation.custom"); } catch { /* ignore */ }
    setEditing(false);
  }

  return (
    <>
      <div className="motivation-card" onClick={() => setFullscreen(true)}>
        <div className="motivation-card__glow" />
        <div className="motivation-card__inner">
          <div className="motivation-card__head">
            <span className="motivation-card__label">Motivation</span>
            <div className="motivation-card__actions" onClick={(e) => e.stopPropagation()}>
              <button
                className="motivation-card__btn"
                onClick={() => { setEditing(true); setDraft(customText); }}
                title="Add your own message"
              >
                +
              </button>
            </div>
          </div>
          <div className="motivation-card__emoji">{displayedEmoji}</div>
          <p className="motivation-card__msg">{displayedText}</p>
          {!customText.trim() && <p className="motivation-card__sub">{subline}</p>}
          <p className="motivation-card__hint">Click to expand</p>
        </div>
      </div>

      {editing && (
        <div className="modal-backdrop" onClick={() => setEditing(false)}>
          <div className="modal motivation-edit" onClick={(e) => e.stopPropagation()}>
            <button className="screenshot-close" onClick={() => setEditing(false)}>×</button>
            <h3>Your motivation message</h3>
            <p className="dim">This text will appear on the card, or open it fullscreen for a calm pause.</p>
            <textarea
              className="motivation-edit__input"
              value={draft}
              onChange={(e) => setDraft(e.target.value)}
              placeholder="Write something that keeps you grounded, e.g. 'Protect capital. Trust the process.'"
              maxLength={240}
              rows={4}
              autoFocus
            />
            <div className="motivation-edit__counter">{draft.length} / 240</div>
            <div className="modal__actions">
              {customText && (
                <button className="btn btn--ghost" onClick={clearCustom}>Clear</button>
              )}
              <button className="btn btn--ghost" onClick={() => setEditing(false)}>Cancel</button>
              <button className="btn btn--primary" onClick={saveCustom}>Save</button>
            </div>
          </div>
        </div>
      )}

      {fullscreen && (
        <MotivationFullscreen
          emoji={displayedEmoji}
          text={displayedText}
          subline={subline}
          duration={duration}
          setDuration={setDuration}
          onClose={() => setFullscreen(false)}
        />
      )}
    </>
  );
}

function MotivationFullscreen({ emoji, text, subline, duration, setDuration, onClose }: {
  emoji: string;
  text: string;
  subline: string;
  duration: 5 | 10;
  setDuration: (v: 5 | 10) => void;
  onClose: () => void;
}) {
  const [progress, setProgress] = useState(0);

  useEffect(() => {
    const startTime = Date.now();
    const totalMs = duration * 1000;
    const id = setInterval(() => {
      const elapsed = Date.now() - startTime;
      const pct = Math.min(100, (elapsed / totalMs) * 100);
      setProgress(pct);
      if (pct >= 100) {
        clearInterval(id);
        onClose();
      }
    }, 50);
    return () => clearInterval(id);
  }, [duration, onClose]);

  useEffect(() => {
    function onKey(e: KeyboardEvent) {
      if (e.key === "Escape") onClose();
    }
    document.addEventListener("keydown", onKey);
    return () => document.removeEventListener("keydown", onKey);
  }, [onClose]);

  return (
    <div className="motivation-fs" onClick={onClose}>
      {/* Animated gradient background */}
      <div className="motivation-fs__bg" />
      <div className="motivation-fs__orb motivation-fs__orb--1" />
      <div className="motivation-fs__orb motivation-fs__orb--2" />
      <div className="motivation-fs__orb motivation-fs__orb--3" />

      {/* Duration picker (top right) */}
      <div className="motivation-fs__controls" onClick={(e) => e.stopPropagation()}>
        <button
          className={`motivation-fs__dur ${duration === 5 ? "is-active" : ""}`}
          onClick={() => { setDuration(5); setProgress(0); }}
        >
          5s
        </button>
        <button
          className={`motivation-fs__dur ${duration === 10 ? "is-active" : ""}`}
          onClick={() => { setDuration(10); setProgress(0); }}
        >
          10s
        </button>
        <button className="motivation-fs__close" onClick={onClose} title="Close (Esc)">×</button>
      </div>

      {/* Content */}
      <div className="motivation-fs__content">
        <div className="motivation-fs__emoji">{emoji}</div>
        <h1 className="motivation-fs__text">{text}</h1>
        {!text && <p className="motivation-fs__sub">{subline}</p>}
      </div>

      {/* Progress bar */}
      <div className="motivation-fs__progress">
        <div className="motivation-fs__progress-fill" style={{ width: `${progress}%` }} />
      </div>
    </div>
  );
}

// ============================================================
// Time-of-Day Performance
// ============================================================
function TimeOfDayCard({ trades }: { trades: TradeRDetail[] }) {
  const buckets = [
    { label: "00–04", from: 0, to: 4, r: 0, count: 0 },
    { label: "04–08", from: 4, to: 8, r: 0, count: 0 },
    { label: "08–12", from: 8, to: 12, r: 0, count: 0 },
    { label: "12–16", from: 12, to: 16, r: 0, count: 0 },
    { label: "16–20", from: 16, to: 20, r: 0, count: 0 },
    { label: "20–24", from: 20, to: 24, r: 0, count: 0 },
  ];

  for (const t of trades) {
    if (!t.closed_at) continue;
    const d = new Date(t.closed_at);
    if (isNaN(d.getTime())) continue;
    const hour = d.getHours();
    const bucket = buckets.find((b) => hour >= b.from && hour < b.to);
    if (bucket) {
      bucket.r += Number(t.r_multiple);
      bucket.count += 1;
    }
  }

  const maxAbs = Math.max(1, ...buckets.map((b) => Math.abs(b.r)));

  return (
    <section className="card">
      <div className="card__head">
        <h3>Performance by Time of Day</h3>
        <span className="card__badge">{trades.length} trades</span>
      </div>
      {trades.length === 0 ? (
        <div className="dash__placeholder">Time analysis appears once you have closed trades.</div>
      ) : (
        <div className="tod-list">
          {buckets.map((b) => {
            const pct = (Math.abs(b.r) / maxAbs) * 100;
            const positive = b.r >= 0;
            const empty = b.count === 0;
            return (
              <div key={b.label} className="tod-row">
                <span className="tod-row__label mono">{b.label}</span>
                <div className="tod-row__bar-wrap">
                  <div
                    className={`tod-row__bar ${positive ? "is-positive" : "is-negative"} ${empty ? "is-empty" : ""}`}
                    style={{ width: `${empty ? 0 : pct}%` }}
                  />
                </div>
                <span className={`tod-row__value mono ${positive ? "pos" : "neg"}`}>
                  {empty ? "—" : `${positive ? "+" : ""}${b.r.toFixed(2)}R`}
                </span>
                <span className="tod-row__count mono dim">{b.count}</span>
              </div>
            );
          })}
        </div>
      )}
    </section>
  );
}
