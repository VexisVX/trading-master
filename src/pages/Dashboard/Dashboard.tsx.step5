import { useEffect, useState } from "react";
import { getSummary, Summary, TradeRDetail } from "../../lib/analyticsApi";
import { getGoals, AccountGoals } from "../../lib/goalsApi";
import { getRiskStatus, RiskStatus } from "../../lib/riskSettingsApi";
import { getPropFirmStatus, PropFirmStatus } from "../../lib/propFirmApi";
import { LineChart } from "../../components/charts/LineChart";
import { BarChart } from "../../components/charts/BarChart";
import { Donut } from "../../components/charts/Donut";
import "./Dashboard.css";

export function Dashboard() {
  const [s, setS] = useState<Summary | null>(null);
  const [goals, setGoals] = useState<AccountGoals | null>(null);
  const [risk, setRisk] = useState<RiskStatus | null>(null);
  const [pf, setPf] = useState<PropFirmStatus | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    (async () => {
      try {
        setS(await getSummary());
        try {
          const { getActiveAccountId } = await import("../../lib/accountsApi");
          const accId = await getActiveAccountId();
          setGoals(await getGoals(accId));
          try { setRisk(await getRiskStatus(accId)); } catch { setRisk(null); }
          try { setPf(await getPropFirmStatus(accId)); } catch { setPf(null); }
        } catch { /* ignore */ }
      } catch (e) {
        setError(String(e));
      } finally {
        setLoading(false);
      }
    })();
  }, []);

  if (loading) return <div className="dash"><div className="card">Loading…</div></div>;
  if (error) return <div className="dash"><div className="card">Error: {error}</div></div>;
  if (!s) return <div className="dash"><div className="card">No data</div></div>;

  return (
    <div className="dash">
      <h1 className="dash__title">Dashboard</h1>

      <div className="dash__grid">
        <div className="card">
          <div className="stat__label">Balance</div>
          <div className="stat__value mono">${Number(s.current_equity).toLocaleString()}</div>
        </div>
        <div className="card">
          <div className="stat__label">Net P&L</div>
          <div className="stat__value mono">${Number(s.net_pnl).toFixed(2)}</div>
        </div>
        <div className="card">
          <div className="stat__label">Win Rate</div>
          <div className="stat__value mono">{Number(s.win_rate_pct).toFixed(1)}%</div>
        </div>
        <div className="card">
          <div className="stat__label">Open</div>
          <div className="stat__value mono">{s.open_trades}</div>
        </div>
      </div>

      <div className="dash__row dash__row--3">
        <div className="card">
          <div className="card__head">
            <h3>R-Multiple Distribution</h3>
          </div>
          {s.r_distribution.some((b) => b.count > 0) ? (
            <BarChart
              data={s.r_distribution.map((b) => ({ label: b.label.replace("R", ""), v: b.count }))}
              height={180}
            />
          ) : (
            <div className="dash__placeholder">No R data yet.</div>
          )}
        </div>

        <div className="card">
          <div className="card__head">
            <h3>Win / Loss</h3>
          </div>
          {s.wins + s.losses > 0 ? (
            <Donut wins={s.wins} losses={s.losses} />
          ) : (
            <div className="dash__placeholder">No results yet.</div>
          )}
        </div>

        <div className="card">
          <div className="card__head">
            <h3>Key Stats</h3>
          </div>
          <ul className="risk-list">
            <li>
              <span>Profit factor</span>
              <span className="mono">{Number(s.profit_factor).toFixed(2)}</span>
            </li>
            <li>
              <span>Expectancy</span>
              <span className={`mono ${Number(s.expectancy_r) >= 0 ? "pos" : "neg"}`}>
                {Number(s.expectancy_r) >= 0 ? "+" : ""}{Number(s.expectancy_r).toFixed(2)}R
              </span>
            </li>
            <li>
              <span>Avg win</span>
              <span className="mono pos">
                +{Number(s.avg_win_r).toFixed(2)}R
              </span>
            </li>
            <li>
              <span>Avg loss</span>
              <span className="mono neg">
                {Number(s.avg_loss_r).toFixed(2)}R
              </span>
            </li>
          </ul>
        </div>
      </div>

      <div className="dash__row dash__row--2">
        {goals && (
          <GoalsCard
            goals={goals}
            netPnl={s.net_pnl}
            initialBalance={s.initial_balance}
          />
        )}
        <MotivationCard
          netPnl={s.net_pnl}
          closedTrades={s.closed_trades}
        />
      </div>

      <WeekdayPerformanceCard trades={s.r_details} />

      {risk && (
        <section className="card">
          <div className="card__head">
            <h3>Risk Budget</h3>
            <span className={`card__badge ${risk.max_positions_hit || risk.daily_loss_limit_hit || risk.portfolio_risk_exceeded ? "bad" : "ok"}`}>
              {risk.max_positions_hit || risk.daily_loss_limit_hit || risk.portfolio_risk_exceeded ? "⚠ limits hit" : "within limits"}
            </span>
          </div>
          <div className="risk-budget-grid">
            <RiskBar
              label="Portfolio risk"
              value={Number(risk.open_risk_pct)}
              limit={Number(risk.settings.max_portfolio_risk_pct)}
              unit="%"
            />
            <RiskBar
              label="Daily loss"
              value={Number(risk.daily_loss_pct)}
              limit={Number(risk.settings.daily_loss_limit_pct)}
              unit="%"
            />
            <RiskBar
              label="Open positions"
              value={risk.open_positions}
              limit={risk.settings.max_open_positions}
              unit=""
            />
          </div>
          {risk.warnings.length > 0 && (
            <ul className="risk-warnings">
              {risk.warnings.map((w, i) => <li key={i}>⚠ {w}</li>)}
            </ul>
          )}
        </section>
      )}

      {pf && pf.rules.enabled && (
        <section className="card">
          <div className="card__head">
            <h3>Prop-firm Rules</h3>
            <span className={`card__badge ${pf.all_passed ? "ok" : "bad"}`}>
              {pf.all_passed ? "all passed" : "⚠ breach"}
            </span>
          </div>
          <div className="propfirm-grid">
            {pf.checks.map((c) => (
              <div key={c.name} className={`pf-check ${c.passed ? "is-pass" : "is-fail"}`}>
                <div className="pf-check__head">
                  <span className="pf-check__name">{c.name}</span>
                  <span className={`pf-check__status ${c.passed ? "ok" : "bad"}`}>
                    {c.passed ? "✓" : "✕"}
                  </span>
                </div>
                <div className="pf-check__msg">{c.message}</div>
              </div>
            ))}
          </div>
          <div className="pf-summary mono">
            Peak {Number(pf.peak_equity).toLocaleString()} ·
            Current {Number(pf.current_equity).toLocaleString()} ·
            P&L {Number(pf.total_pnl) >= 0 ? "+" : ""}{Number(pf.total_pnl).toLocaleString()} ·
            Trading days {pf.trading_days}
          </div>
        </section>
      )}

      <div className="card">
        <h3>Closed Trades: {s.closed_trades}</h3>
      </div>

      <div className="dash__row dash__row--2">
        <div className="card">
          <div className="card__head">
            <h3>Equity Curve</h3>
            <span className="card__badge">{s.closed_trades} trades</span>
          </div>
          {s.equity_curve.length > 1 ? (
            <LineChart
              data={s.equity_curve.map((p) => ({ t: p.t, v: Number(p.v) }))}
              formatY={(v) => `$${Math.round(v).toLocaleString()}`}
              height={220}
            />
          ) : (
            <div className="dash__placeholder">Equity curve appears after your first closed trade.</div>
          )}
        </div>

        <div className="card">
          <div className="card__head">
            <h3>Drawdown</h3>
            <span className="card__badge">max {Number(s.max_drawdown_pct).toFixed(1)}%</span>
          </div>
          {s.drawdown_curve.length > 1 ? (
            <LineChart
              data={s.drawdown_curve.map((p) => ({ t: p.t, v: Number(p.v) }))}
              color="var(--danger)"
              formatY={(v) => `${v.toFixed(1)}%`}
              height={220}
            />
          ) : (
            <div className="dash__placeholder">Drawdown will be shown once you have trades.</div>
          )}
        </div>
      </div>
    </div>
  );
}


// ============================================================
// Goals Card
// ============================================================
function GoalsCard({ goals, netPnl, initialBalance }: {
  goals: AccountGoals;
  netPnl: string;
  initialBalance: string;
}) {
  const pnl = Number(netPnl);
  const bal = Number(initialBalance);
  const pnlPct = bal > 0 ? (pnl / bal) * 100 : 0;

  const targets = [
    { label: "Daily", target: Number(goals.daily_target_pct), period: "today" },
    { label: "Weekly", target: Number(goals.weekly_target_pct), period: "this week" },
    { label: "Monthly", target: Number(goals.monthly_target_pct), period: "this month" },
  ];

  return (
    <div className="card goals-card">
      <div className="card__head">
        <h3>Goals</h3>
        <span className={`card__badge ${pnlPct >= targets[2].target ? "ok" : ""}`}>
          {pnlPct >= 0 ? "+" : ""}{pnlPct.toFixed(2)}% this month
        </span>
      </div>
      <div className="goals-list">
        {targets.map((t) => {
          const pct = t.target > 0 ? Math.min(100, Math.max(0, (pnlPct / t.target) * 100)) : 0;
          const done = pct >= 100;
          const positive = pnlPct >= 0;
          return (
            <div key={t.label} className="goal-bar">
              <div className="goal-bar__head">
                <span className="goal-bar__label">{t.label} target</span>
                <span className={`mono ${positive ? "pos" : "neg"}`}>
                  {positive ? "+" : ""}{pnlPct.toFixed(2)}% / {t.target}%
                </span>
              </div>
              <div className="goal-bar__track">
                <div
                  className={`goal-bar__fill ${done ? "is-done" : ""} ${!positive ? "is-negative" : ""}`}
                  style={{ width: `${pct}%` }}
                />
              </div>
              <div className="goal-bar__hint">
                {done ? "✓ Target reached" : `${pct.toFixed(0)}% toward ${t.period} target`}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

// ============================================================
// Motivation Card
// ============================================================
const MOTIVATION_MESSAGES = [
  { min: 1000, msg: "Extraordinary. Discipline is your greatest asset." },
  { min: 500,  msg: "Strong performance. Consistency compounds quietly." },
  { min: 200,  msg: "Well earned. Keep following your plan, not your emotions." },
  { min: 50,   msg: "You are green. Stay patient — the market rewards restraint." },
  { min: 1,    msg: "Small steps forward. Trust your process." },
  { min: -50,  msg: "A pause is not a failure. Review, then continue." },
  { min: -200, msg: "Protect your capital. The next trade is a fresh start." },
  { min: -500, msg: "Slow down. Reduce size, rebuild clarity." },
  { min: -1000,msg: "A losing streak is not a losing trader. Breathe." },
  { min: -999999, msg: "Stop. Rest. Tomorrow is a new opportunity." },
];

function MotivationCard({ netPnl, closedTrades }: {
  netPnl: string;
  closedTrades: number;
}) {
  const pnl = Number(netPnl);
  const message = MOTIVATION_MESSAGES.find((m) => pnl >= m.min);

  const [customText, setCustomText] = useState<string>(() => {
    try { return localStorage.getItem("motivation.custom") || ""; } catch { return ""; }
  });
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(customText);

  const displayedText = customText.trim() || message?.msg || "Keep going.";

  function saveCustom() {
    const v = draft.trim();
    setCustomText(v);
    try { localStorage.setItem("motivation.custom", v); } catch { /* ignore */ }
    setEditing(false);
  }

  return (
    <>
      <div className="motivation-card">
        <div className="motivation-card__bg" />
        <div className="motivation-card__inner">
          <div className="motivation-card__head">
            <span className="motivation-card__label">Motivation</span>
            <button
              className="motivation-card__btn"
              onClick={() => { setEditing(true); setDraft(customText); }}
              title="Add your own message"
            >
              +
            </button>
          </div>
          <p className="motivation-card__msg">{displayedText}</p>
          {closedTrades === 0 && (
            <p className="motivation-card__sub">Start with your first trade.</p>
          )}
        </div>
      </div>

      {editing && (
        <div className="modal-backdrop" onClick={() => setEditing(false)}>
          <div className="modal motivation-edit" onClick={(e) => e.stopPropagation()}>
            <button className="screenshot-close" onClick={() => setEditing(false)}>×</button>
            <h3>Your motivation</h3>
            <p className="dim">A phrase that keeps you grounded.</p>
            <textarea
              className="motivation-edit__input"
              value={draft}
              onChange={(e) => setDraft(e.target.value)}
              placeholder="e.g. 'Protect capital. Trust the process.'"
              maxLength={240}
              rows={4}
              autoFocus
            />
            <div className="motivation-edit__counter">{draft.length} / 240</div>
            <div className="modal__actions">
              <button className="btn btn--ghost" onClick={() => setEditing(false)}>Cancel</button>
              <button className="btn btn--primary" onClick={saveCustom}>Save</button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}


// ============================================================
// Weekday Performance
// ============================================================
const WEEKDAY_LABELS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

function WeekdayPerformanceCard({ trades }: { trades: TradeRDetail[] }) {
  const buckets = WEEKDAY_LABELS.map((label) => ({ label, r: 0, count: 0 }));

  for (const t of trades) {
    if (!t.closed_at) continue;
    const d = new Date(t.closed_at);
    if (isNaN(d.getTime())) continue;
    // JS: Sunday=0, Monday=1 ... Saturday=6
    const jsDay = d.getDay();
    const idx = jsDay === 0 ? 6 : jsDay - 1; // Monday=0
    buckets[idx].r += Number(t.r_multiple);
    buckets[idx].count += 1;
  }

  const maxAbs = Math.max(1, ...buckets.map((b) => Math.abs(b.r)));
  let bestIdx = -1;
  let worstIdx = -1;
  buckets.forEach((b, i) => {
    if (b.count === 0) return;
    if (bestIdx === -1 || b.r > buckets[bestIdx].r) bestIdx = i;
    if (worstIdx === -1 || b.r < buckets[worstIdx].r) worstIdx = i;
  });

  return (
    <section className="card">
      <div className="card__head">
        <h3>Performance by Day of Week</h3>
        <span className="card__badge">{trades.length} trades</span>
      </div>
      {trades.length === 0 ? (
        <div className="dash__placeholder">Day analysis appears once you have closed trades.</div>
      ) : (
        <div className="weekday-grid">
          {buckets.map((b, i) => {
            const empty = b.count === 0;
            const positive = b.r >= 0;
            const pct = (Math.abs(b.r) / maxAbs) * 100;
            const isBest = i === bestIdx && b.count > 0 && bestIdx !== worstIdx;
            const isWorst = i === worstIdx && b.count > 0 && bestIdx !== worstIdx;

            return (
              <div
                key={b.label}
                className={`wd-col ${empty ? "is-empty" : ""} ${isBest ? "is-best" : ""} ${isWorst ? "is-worst" : ""}`}
              >
                <div className="wd-col__label">{b.label}</div>
                <div className="wd-col__bar-wrap">
                  <div
                    className={`wd-col__bar ${positive ? "is-positive" : "is-negative"}`}
                    style={{ height: `${empty ? 0 : Math.max(8, pct)}%` }}
                  />
                </div>
                <div className={`wd-col__value mono ${empty ? "dim" : positive ? "pos" : "neg"}`}>
                  {empty ? "—" : `${positive ? "+" : ""}${b.r.toFixed(1)}R`}
                </div>
                <div className="wd-col__count mono dim">
                  {b.count > 0 ? `${b.count}t` : ""}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>
  );
}


// ============================================================
// Risk Bar
// ============================================================
function RiskBar({ label, value, limit, unit }: {
  label: string;
  value: number;
  limit: number;
  unit: string;
}) {
  const pct = limit > 0 ? Math.min(100, (value / limit) * 100) : 0;
  const danger = pct >= 100;
  const warn = pct >= 75 && !danger;
  const tone = danger ? "var(--danger)" : warn ? "var(--warning)" : "var(--accent)";
  const fmt = (v: number) => (unit === "%" ? v.toFixed(2) : String(v));
  return (
    <div className="risk-bar">
      <div className="risk-bar__head">
        <span>{label}</span>
        <span className={`mono ${danger ? "neg" : warn ? "" : "pos"}`}>
          {fmt(value)}{unit} / {fmt(limit)}{unit}
        </span>
      </div>
      <div className="risk-bar__track">
        <div className="risk-bar__fill" style={{ width: `${pct}%`, background: tone }} />
      </div>
    </div>
  );
}
