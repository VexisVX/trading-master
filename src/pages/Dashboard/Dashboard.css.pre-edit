/* ============================================================
   DASHBOARD — base layout
   ============================================================ */
.dash { display: flex; flex-direction: column; gap: 20px; }

.dash__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.dash__title { margin: 0 0 4px; font-size: 22px; font-weight: 700; letter-spacing: -0.3px; color: var(--text-0); }
.dash__subtitle { margin: 0; font-size: 12.5px; color: var(--text-1); }

.dash__refresh {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: var(--bg-1);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-1);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.12s, color 0.12s, border-color 0.12s;
}
.dash__refresh:hover:not(:disabled) { background: var(--bg-2); color: var(--text-0); border-color: var(--border-strong); }
.dash__refresh:disabled { opacity: 0.6; cursor: wait; }
.dash__refresh-icon { display: inline-block; }
.dash__refresh.is-refreshing .dash__refresh-icon { animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ============================================================
   GRID
   ============================================================ */
.dash__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.dash__row { display: grid; gap: 16px; }
.dash__row--2 { grid-template-columns: 2fr 1fr; }
.dash__row--3 { grid-template-columns: repeat(3, 1fr); }
@media (max-width: 1200px) {
  .dash__grid { grid-template-columns: repeat(2, 1fr); }
  .dash__row--2, .dash__row--3 { grid-template-columns: 1fr; }
}
@media (max-width: 700px) { .dash__grid { grid-template-columns: 1fr; } }

/* ============================================================
   CARD
   ============================================================ */
.card {
  background: var(--bg-1);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  min-width: 0;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
              border-color 0.2s cubic-bezier(0.22, 0.61, 0.36, 1),
              box-shadow 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.dash .card:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
}
.dash .card:hover .card__head h3 { color: var(--accent); }

.card__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.card__head h3 { margin: 0; font-size: 13.5px; font-weight: 600; color: var(--text-0); transition: color 0.2s; }
.card__badge { font-size: 10.5px; padding: 3px 9px; border-radius: 999px; background: var(--bg-3); color: var(--text-1); font-weight: 500; }
.card__badge.ok { background: var(--accent-soft); color: var(--accent); }
.card__badge.bad { background: rgba(248,113,113,0.12); color: var(--danger); }

/* ============================================================
   STAT CARD
   ============================================================ */
.stat { display: flex; flex-direction: column; gap: 8px; }
.stat__head { display: flex; align-items: center; justify-content: space-between; }
.stat__label { font-size: 11.5px; color: var(--text-2); letter-spacing: 0.4px; text-transform: uppercase; font-weight: 600; }
.stat__row { display: flex; align-items: baseline; gap: 6px; }
.stat__value { font-size: 24px; font-weight: 700; letter-spacing: -0.5px; color: var(--text-0); transition: color 0.2s; line-height: 1.1; }
.stat__value--accent { color: var(--accent); }
.stat__value--success { color: var(--success); }
.stat__value--danger { color: var(--danger); }
.stat__trend { font-size: 14px; font-weight: 700; }
.stat__trend--up { color: var(--success); }
.stat__trend--down { color: var(--danger); }
.stat__hint { font-size: 11px; color: var(--text-3); }
.dash .stat:hover .stat__value { color: var(--accent); }

/* ============================================================
   KPI STRIP
   ============================================================ */
.kpi-strip { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; padding: 16px 20px; }
@media (max-width: 1100px) { .kpi-strip { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 700px) { .kpi-strip { grid-template-columns: repeat(2, 1fr); } }
.kpi { display: flex; flex-direction: column; gap: 4px; }
.kpi__label { font-size: 10.5px; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.3px; font-weight: 600; }
.kpi__value { font-size: 16px; font-weight: 600; color: var(--text-0); }
.kpi__value--success { color: var(--success); }
.kpi__value--danger { color: var(--danger); }

/* ============================================================
   RISK LIST
   ============================================================ */
.risk-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
.risk-list li { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--text-1); padding-bottom: 8px; border-bottom: 1px solid var(--border); }
.risk-list li:last-child { border-bottom: none; padding-bottom: 0; }
.risk-list li span:last-child { color: var(--text-0); font-weight: 500; }
.risk-list .pos { color: var(--success); }
.risk-list .neg { color: var(--danger); }

/* ============================================================
   RISK BAR
   ============================================================ */
.risk-budget-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 12px; }
@media (max-width: 900px) { .risk-budget-grid { grid-template-columns: 1fr; } }
.risk-bar { display: flex; flex-direction: column; gap: 6px; }
.risk-bar__head { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--text-1); }
.risk-bar__head .pos { color: var(--text-0); }
.risk-bar__head .neg { color: var(--danger); }
.risk-bar__track { height: 8px; background: var(--bg-3); border-radius: 999px; overflow: hidden; }
.risk-bar__fill { height: 100%; border-radius: 999px; transition: width 0.3s ease-out, background 0.2s; }
.risk-warnings { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--warning); }

/* ============================================================
   PROP-FIRM
   ============================================================ */
.propfirm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin-bottom: 12px; }
.pf-check { padding: 12px 14px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm); transition: border-color 0.15s, background 0.15s; }
.pf-check:hover { background: var(--bg-3); }
.pf-check.is-fail { border-color: rgba(248, 113, 113, 0.35); }
.pf-check__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.pf-check__name { font-size: 11px; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.4px; font-weight: 600; }
.pf-check__status { font-weight: 700; font-size: 13px; }
.pf-check__status.ok { color: var(--accent); }
.pf-check__status.bad { color: var(--danger); }
.pf-check__msg { font-size: 12px; color: var(--text-0); line-height: 1.4; }
.pf-summary { font-size: 11px; color: var(--text-2); padding-top: 10px; border-top: 1px solid var(--border); }

/* ============================================================
   TABLE
   ============================================================ */
.trades { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.trades th { text-align: left; font-weight: 600; color: var(--text-2); padding: 8px; border-bottom: 1px solid var(--border); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.4px; }
.trades td { padding: 10px 8px; border-bottom: 1px solid var(--border); }
.trades tr:last-child td { border-bottom: none; }
.trades tbody tr { transition: background 0.12s; }
.trades tbody tr:hover { background: var(--bg-2); }
.trades .pos { color: var(--success); font-weight: 500; }
.trades .neg { color: var(--danger); font-weight: 500; }
.trades .dim { color: var(--text-3); }
.side-long { color: var(--success); font-weight: 600; }
.side-short { color: var(--danger); font-weight: 600; }

/* ============================================================
   PLACEHOLDER / EMPTY / ERROR
   ============================================================ */
.dash__placeholder {
  display: flex; align-items: center; justify-content: center;
  min-height: 120px; color: var(--text-2); font-size: 12px;
  border: 1px dashed var(--border); border-radius: var(--radius-sm);
  padding: 24px; text-align: center; line-height: 1.5;
}
.dash-empty, .dash-error {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 10px; padding: 80px 24px; text-align: center;
  background: var(--bg-1); border: 1px solid var(--border); border-radius: var(--radius);
}
.dash-empty__icon, .dash-error__icon { font-size: 40px; opacity: 0.5; margin-bottom: 6px; }
.dash-empty__title, .dash-error__title { font-size: 16px; font-weight: 600; color: var(--text-0); }
.dash-empty__hint, .dash-error__msg { font-size: 13px; color: var(--text-1); max-width: 400px; line-height: 1.5; margin-bottom: 10px; }
.dash-error__icon { color: var(--danger); }
.dash-error__title { color: var(--danger); }

/* ============================================================
   GOALS CARD
   ============================================================ */
.goals-card { display: flex; flex-direction: column; gap: 12px; }
.goals-list { display: flex; flex-direction: column; gap: 14px; }
.goal-bar { display: flex; flex-direction: column; gap: 4px; }
.goal-bar__head { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--text-1); }
.goal-bar__label { font-weight: 500; }
.goal-bar__track { height: 8px; background: var(--bg-3); border-radius: 999px; overflow: hidden; }
.goal-bar__fill { height: 100%; background: var(--accent); border-radius: 999px; transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
.goal-bar__fill.is-done { background: var(--success); box-shadow: 0 0 12px rgba(52, 211, 153, 0.4); }
.goal-bar__fill.is-negative { background: var(--danger); }
.goal-bar__hint { font-size: 10.5px; color: var(--text-3); }
.goal-note { margin: 4px 0 0; font-size: 10.5px; color: var(--text-3); padding-top: 10px; border-top: 1px solid var(--border); }

/* ============================================================
   MOTIVATION EDIT MODAL
   ============================================================ */
.motivation-edit { min-width: 480px; max-width: 560px; padding: 24px; }
.motivation-edit h3 { margin: 0 0 8px; font-size: 16px; }
.motivation-edit .dim { font-size: 12.5px; color: var(--text-1); margin: 0 0 16px; line-height: 1.5; }
.motivation-edit__input {
  width: 100%;
  padding: 12px 14px;
  font-size: 13.5px;
  line-height: 1.55;
  background: var(--bg-0);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text-0);
  font-family: inherit;
  resize: vertical;
  outline: none;
}
.motivation-edit__input:focus { border-color: var(--accent); }
.motivation-edit__counter { text-align: right; font-size: 10.5px; color: var(--text-3); margin: 6px 0 16px; }

/* ============================================================
   MOTIVATION FULLSCREEN
   ============================================================ */
.motivation-fs {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: #05090d;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  overflow: hidden;
  animation: fsFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes fsFadeIn { from { opacity: 0; } to { opacity: 1; } }

.motivation-fs__bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at top left, rgba(45, 212, 191, 0.15), transparent 50%),
    radial-gradient(ellipse at bottom right, rgba(45, 212, 191, 0.1), transparent 50%);
  animation: fsBgShift 12s ease-in-out infinite alternate;
}
@keyframes fsBgShift {
  0% { transform: scale(1) rotate(0deg); }
  100% { transform: scale(1.15) rotate(3deg); }
}

.motivation-fs__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}
.motivation-fs__orb--1 {
  width: 500px; height: 500px;
  background: rgba(45, 212, 191, 0.25);
  top: -100px; left: -100px;
  animation: orbFloat 20s ease-in-out infinite;
}
.motivation-fs__orb--2 {
  width: 400px; height: 400px;
  background: rgba(20, 184, 166, 0.15);
  bottom: -100px; right: -100px;
  animation: orbFloat 18s ease-in-out infinite reverse;
}
.motivation-fs__orb--3 {
  width: 300px; height: 300px;
  background: rgba(45, 212, 191, 0.08);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  animation: orbFloat 25s ease-in-out infinite;
}
@keyframes orbFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(30px, -40px) scale(1.1); }
  50% { transform: translate(-30px, 30px) scale(0.95); }
  75% { transform: translate(20px, 20px) scale(1.05); }
}

.motivation-fs__content {
  position: relative;
  z-index: 2;
  max-width: 900px;
  padding: 40px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  animation: contentEnter 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes contentEnter {
  from { opacity: 0; transform: translateY(20px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.motivation-fs__text {
  font-family: "Cormorant Garamond", "Playfair Display", Georgia, serif;
  font-size: clamp(32px, 5vw, 56px);
  font-weight: 500;
  line-height: 1.25;
  color: #ffffff;
  margin: 0;
  letter-spacing: -0.5px;
  text-shadow: 0 2px 40px rgba(45, 212, 191, 0.3);
  word-break: break-word;
  overflow-wrap: break-word;
  max-width: 100%;
}

.motivation-fs__sub {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(16px, 2vw, 22px);
  font-style: italic;
  color: rgba(230, 237, 243, 0.7);
  margin: 0;
  max-width: 700px;
}

.motivation-fs__controls {
  position: absolute;
  top: 20px; right: 24px;
  display: flex;
  gap: 8px;
  z-index: 10;
}
.motivation-fs__dur {
  padding: 6px 14px;
  font-size: 12px;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 6px;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition: all 0.12s;
}
.motivation-fs__dur:hover { background: rgba(255, 255, 255, 0.15); color: white; }
.motivation-fs__dur.is-active { background: var(--accent); color: #052e2b; border-color: var(--accent); }
.motivation-fs__close {
  width: 30px; height: 30px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.7);
  font-size: 18px;
  cursor: pointer;
  transition: all 0.12s;
}
.motivation-fs__close:hover { background: rgba(255, 255, 255, 0.15); color: white; }

.motivation-fs__progress {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 3px;
  background: rgba(255, 255, 255, 0.08);
  z-index: 10;
}
.motivation-fs__progress-fill {
  height: 100%;
  background: var(--accent);
  transition: width 0.05s linear;
  box-shadow: 0 0 12px var(--accent);
}

/* ============================================================
   WEEKDAY PERFORMANCE
   ============================================================ */
.weekday-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10px;
  padding: 12px 4px 4px;
  align-items: end;
}
.wd-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 6px 2px;
  border-radius: 8px;
  transition: background 0.15s;
  min-height: 140px;
}
.wd-col:hover { background: var(--bg-2); }
.wd-col.is-empty { opacity: 0.5; }
.wd-col.is-best {
  background: rgba(45, 212, 191, 0.08);
  box-shadow: inset 0 0 0 1px rgba(45, 212, 191, 0.2);
}
.wd-col.is-worst {
  background: rgba(248, 113, 113, 0.06);
  box-shadow: inset 0 0 0 1px rgba(248, 113, 113, 0.15);
}
.wd-col__label {
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-2);
  font-weight: 600;
}
.wd-col.is-best .wd-col__label { color: var(--accent); }
.wd-col.is-worst .wd-col__label { color: var(--danger); }
.wd-col__bar-wrap {
  width: 100%;
  height: 80px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
}
.wd-col__bar {
  width: 70%;
  min-height: 4px;
  border-radius: 4px 4px 0 0;
  transition: height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
.wd-col__bar.is-positive {
  background: linear-gradient(180deg, var(--accent) 0%, rgba(45, 212, 191, 0.4) 100%);
  box-shadow: 0 0 12px rgba(45, 212, 191, 0.3);
}
.wd-col__bar.is-negative {
  background: linear-gradient(180deg, var(--danger) 0%, rgba(248, 113, 113, 0.4) 100%);
  box-shadow: 0 0 12px rgba(248, 113, 113, 0.25);
}
.wd-col__value {
  font-size: 11.5px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.wd-col__value.pos { color: var(--accent); }
.wd-col__value.neg { color: var(--danger); }
.wd-col__value.dim { color: var(--text-3); }
.wd-col__count { font-size: 9.5px; }

@media (max-width: 700px) { .weekday-grid { grid-template-columns: repeat(4, 1fr); } }

/* ============================================================
   SKELETON
   ============================================================ */
.skeleton {
  background: linear-gradient(90deg, var(--bg-2) 0%, var(--bg-3) 40%, var(--bg-2) 80%);
  background-size: 200% 100%;
  border-radius: var(--radius-sm);
  animation: skeletonWave 1.2s ease-in-out infinite;
}
@keyframes skeletonWave {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}
.skeleton-line { height: 12px; margin: 6px 0; }
.skeleton-block { height: 80px; }

/* ============================================================
   MOTIVATION CARD — animated
   ============================================================ */
.motivation-card {
  position: relative;
  overflow: hidden;
  padding: 0;
  background: linear-gradient(135deg,
    rgba(45, 212, 191, 0.10) 0%,
    rgba(45, 212, 191, 0.03) 50%,
    rgba(20, 184, 166, 0.06) 100%);
  border: 1px solid rgba(45, 212, 191, 0.2);
  cursor: default;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
              border-color 0.3s ease-out,
              box-shadow 0.3s ease-out;
  animation: motivationCardIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes motivationCardIn {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
.motivation-card:hover {
  transform: translateY(-2px);
  border-color: rgba(45, 212, 191, 0.4);
  box-shadow: 0 8px 32px rgba(45, 212, 191, 0.15);
}

/* Animated gradient background — drifting orbs */
.motivation-card__bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(45, 212, 191, 0.18) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(20, 184, 166, 0.14) 0%, transparent 50%),
    radial-gradient(circle at 50% 50%, rgba(45, 212, 191, 0.06) 0%, transparent 60%);
  animation: motivationDrift 8s ease-in-out infinite alternate;
  pointer-events: none;
}
@keyframes motivationDrift {
  0%   { transform: translate(0, 0) scale(1); opacity: 0.9; }
  50%  { transform: translate(3%, -3%) scale(1.08); opacity: 1; }
  100% { transform: translate(-2%, 2%) scale(1.03); opacity: 0.9; }
}

/* Glowing pulse at top corner */
.motivation-card::before {
  content: "";
  position: absolute;
  top: -60px;
  right: -60px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(45, 212, 191, 0.3) 0%, transparent 70%);
  filter: blur(20px);
  animation: motivationGlow 4s ease-in-out infinite;
  pointer-events: none;
}
@keyframes motivationGlow {
  0%, 100% {
    opacity: 0.4;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.2);
  }
}

/* Shimmer line at top */
.motivation-card::after {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(45, 212, 191, 0.6) 50%,
    transparent 100%);
  animation: motivationShimmer 3s ease-in-out infinite;
  pointer-events: none;
}
@keyframes motivationShimmer {
  0%   { left: -100%; }
  50%  { left: 100%; }
  100% { left: 100%; }
}

.motivation-card__inner {
  position: relative;
  padding: 20px 22px;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 100%;
}

.motivation-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.motivation-card__label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--accent);
  font-weight: 700;
  opacity: 0.9;
  animation: labelPulse 3s ease-in-out infinite;
}
@keyframes labelPulse {
  0%, 100% { opacity: 0.9; }
  50% { opacity: 0.5; }
}

/* Message — fades in with slight rise */
.motivation-card__msg {
  margin: 0;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.55;
  color: var(--text-0);
  font-style: italic;
  word-break: break-word;
  overflow-wrap: break-word;
  animation: msgFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  position: relative;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
@keyframes msgFadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Subtle underline that grows */
.motivation-card__msg::after {
  content: "";
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 40px;
  height: 1px;
  background: var(--accent);
  opacity: 0.4;
  animation: underlineGrow 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both;
}
@keyframes underlineGrow {
  from { width: 0; }
  to { width: 40px; }
}

.motivation-card__sub {
  margin: 8px 0 0;
  font-size: 11.5px;
  color: var(--text-1);
  line-height: 1.5;
  opacity: 0.8;
  animation: msgFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
}

/* Reduced motion — turn off all */
.motion-off .motivation-card,
.motion-off .motivation-card__bg,
.motion-off .motivation-card::before,
.motion-off .motivation-card::after,
.motion-off .motivation-card__label,
.motion-off .motivation-card__msg,
.motion-off .motivation-card__msg::after,
.motion-off .motivation-card__sub {
  animation: none;
  opacity: 1;
  transform: none;
}

.motion-reduced .motivation-card__bg,
.motion-reduced .motivation-card::before,
.motion-reduced .motivation-card::after {
  animation: none;
}

