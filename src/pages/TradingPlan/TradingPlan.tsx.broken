  }
  .banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(255,255,255,0.25), transparent 60%);
    pointer-events: none;
  }
  .title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.5px;
    position: relative;
  }
  .strategy {
    font-size: 13px;
    font-weight: 500;
    opacity: 0.85;
    margin-top: 6px;
    position: relative;
  }
  .plan-name {
    display: inline-block;
    margin-top: 10px;
    padding: 4px 12px;
    background: rgba(5,46,43,0.15);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    position: relative;
  }
  .body { padding: 32px 40px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 28px;
  }
  .cell {
    padding: 12px 14px;
    border: 1px solid ${border};
    border-radius: 10px;
    background: ${dark ? "#161d26" : "#fafbfc"};
  }
  .cell-label {
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: ${fgDim};
    margin-bottom: 4px;
  }
  .cell-value {
    font-size: 13px;
    font-weight: 600;
    color: ${fg};
    min-height: 18px;
    border-bottom: 1px dashed ${border};
    padding-bottom: 2px;
  }
  .section-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: ${accent};
    margin: 24px 0 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .section-title::before {
    content: "";
    width: 3px;
    height: 14px;
    background: ${accent};
    border-radius: 2px;
  }
  .group { margin-bottom: 16px; }
  .group-title {
    font-size: 10.5px;
    color: ${fgMuted};
    text-transform: uppercase;
