      <div class="notes-area"></div>
    </div>

    <div class="section">
      <div class="section-title">Review (after trade)</div>
      <div class="notes-area small"></div>
    </div>

    <div class="footer">
      Generated ${escapeHtml(new Date().toLocaleDateString())} · Trading Manager v0.1.0
    </div>
  </div>
</body>
</html>`;
  }

  // ---- UI style: app card look ----
  if (isUI) {
    const bg = dark ? "#11161d" : "#ffffff";
    const bgOuter = dark ? "#0b0f14" : "#f1f5f9";
    const fg = dark ? "#e6edf3" : "#0f172a";
    const fgMuted = dark ? "#9aa7b4" : "#475569";
    const fgDim = dark ? "#6b7886" : "#94a3b8";
    const border = dark ? "#232c38" : "#e2e8f0";

    return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>${escapeHtml(planName || "Trading Plan")}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
