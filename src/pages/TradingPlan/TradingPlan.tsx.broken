    .page { box-shadow: none; }
  }
</style>
</head>
<body>
  <div class="page">
    <div class="banner">
      <div class="title">Trading Plan</div>
      <div class="strategy">${escapeHtml(strategyName)}</div>
      <div class="plan-name">${escapeHtml(planName || "Untitled")}</div>
    </div>

    <div class="body">
      <div class="grid">
        <div class="cell"><div class="cell-label">Date</div><div class="cell-value"></div></div>
        <div class="cell"><div class="cell-label">Time</div><div class="cell-value"></div></div>
        <div class="cell"><div class="cell-label">Asset</div><div class="cell-value"></div></div>
        <div class="cell"><div class="cell-label">Entry</div><div class="cell-value"></div></div>
        <div class="cell"><div class="cell-label">Stop</div><div class="cell-value"></div></div>
        <div class="cell"><div class="cell-label">Target</div><div class="cell-value"></div></div>
        <div class="cell"><div class="cell-label">R:R Planned</div><div class="cell-value"></div></div>
        <div class="cell"><div class="cell-label">R Realized</div><div class="cell-value"></div></div>
        <div class="cell"><div class="cell-label">Outcome</div><div class="cell-value"></div></div>
      </div>

      <div class="section-title">Checklist</div>
      ${itemsHtml || '<div class="item">No items</div>'}

      <div class="section-title">Notes</div>
      <div class="notes"></div>
    </div>

    <div class="footer">
      Generated ${escapeHtml(new Date().toLocaleDateString())} · Trading Manager v0.1.0
    </div>
  </div>
</body>
</html>`;
}): string {
  const { planName, strategyName, items, checked, style, theme } = opts;
  const dark = theme === "dark";
  const dateStr = new Date().toLocaleDateString(undefined, {
    weekday: "long", year: "numeric", month: "long", day: "numeric",
  });
  const timeStr = new Date().toLocaleTimeString(undefined, {
    hour: "2-digit", minute: "2-digit",
  });

  const groups = ["htf", "drt", "dfr", "time_model", "entry", "other"] as const;
  const titles: Record<string, string> = {
    htf: "HTF / Long Term",
    drt: "DRT",
    dfr: "DFR",
    time_model: "Time Model",
    entry: "Entry / LTF",
    other: "Other",
  };

  const bg = dark ? "#11161d" : "#fdfcfb";
  const bgOuter = dark ? "#0b0f14" : "#f5f0e6";
  const fg = dark ? "#e6edf3" : "#1a1a1a";
  const fgMuted = dark ? "#9aa7b4" : "#666";
  const fgDim = dark ? "#6b7886" : "#999";
  const border = dark ? "#232c38" : "#e2e8f0";
  const accent = dark ? "#2dd4bf" : "#0d9488";
  const accentBg = dark ? "rgba(45,212,191,0.08)" : "rgba(13,148,136,0.08)";

  const itemsHtml = groups.map((cat) => {
    const catItems = items.filter((i) => i.category === cat);
    if (catItems.length === 0) return "";
    return `
      <div class="group">
        <div class="group-title">${titles[cat]}</div>
        ${catItems.map((it) => {
          const isChecked = checked.has(it.id);
          return `
            <div class="item ${isChecked ? "is-checked" : ""}">
              <span class="check">${isChecked ? "✓" : ""}</span>
              <span class="text">${escapeHtml(it.text || "(empty)")}</span>
            </div>
          `;
        }).join("")}
      </div>
    `;
  }).join("");

  const baseCss = `
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
      background: ${bgOuter};
      color: ${fg};
      padding: 40px 20px;
      line-height: 1.5;
    }
    .page {
      max-width: 820px;
      margin: 0 auto;
      background: ${bg};
      padding: 48px 56px;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12);
    }
    .title {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: ${accent};
    }
    .title-line {
      width: 60px;
      height: 3px;
      background: ${accent};
      margin-top: 8px;
    }
    .meta {
      margin-top: 20px;
      font-size: 13px;
      color: ${fgMuted};
    }
    .meta-row { margin-bottom: 6px; }
    .meta-label { display: inline-block; width: 90px; color: ${fgDim}; }
    .sep {
      border-top: 1px solid ${border};
      margin: 28px 0 20px;
    }
    .section-head {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: ${fgDim};
      margin-bottom: 12px;
      font-weight: 600;
    }
    .group { margin-bottom: 20px; }
    .group-title {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: ${accent};
      font-weight: 600;
      margin-bottom: 8px;
      padding-bottom: 4px;
      border-bottom: 1px solid ${border};
    }
    .item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 6px 0;
      font-size: 13px;
    }
    .item.is-checked { color: ${fgMuted}; }
    .item.is-checked .text { text-decoration: line-through; }
    .check {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border: 1.5px solid ${fgDim};
      border-radius: 4px;
      font-size: 11px;
      font-weight: 700;
      color: ${accent};
      flex-shrink: 0;
      margin-top: 1px;
    }
    .item.is-checked .check {
      background: ${accentBg};
      border-color: ${accent};
    }
    .progress {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      background: ${accentBg};
      border-radius: 6px;
      margin-bottom: 20px;
      font-size: 12px;
      color: ${accent};
      font-weight: 600;
    }
    .progress-bar {
      flex: 1;
      height: 4px;
      background: ${border};
      border-radius: 2px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      background: ${accent};
      border-radius: 2px;
    }
    .footer {
      margin-top: 32px;
      padding-top: 16px;
      border-top: 1px solid ${border};
      font-size: 10px;
      color: ${fgDim};
      display: flex;
      justify-content: space-between;
    }
    @media print {
      body { background: white; padding: 0; }
      .page { box-shadow: none; padding: 30px; }
    }
  `;

  // Style-specific overrides
  let styleCss = "";
  if (style === "journal") {
    styleCss = `
      .title { font-family: Georgia, serif; }
      .page { padding: 56px 64px; }
    `;
  } else if (style === "ui") {
    styleCss = `
      .page {
        border: 1px solid ${border};
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
      }
      .title { font-size: 20px; }
    `;
  } else if (style === "hybrid") {
    styleCss = `
      .page {
        border-radius: 14px;
        overflow: hidden;
        padding: 0;
      }
      .page-inner { padding: 44px 52px; }
      .page::before {
        content: "";
        display: block;
        height: 5px;
        background: linear-gradient(90deg, #2dd4bf 0%, #14b8a6 100%);
      }
    `;
  }

  const pageInnerOpen = style === "hybrid" ? '<div class="page-inner">' : "";
  const pageInnerClose = style === "hybrid" ? "</div>" : "";

  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>${escapeHtml(planName || "Trading Plan")}</title>
<style>${baseCss}${styleCss}</style>
</head>
<body>
  <div class="page">
    ${pageInnerOpen}
    <div class="title">TRADING PLAN</div>
    <div class="title-line"></div>

    <div class="meta">
      <div class="meta-row"><span class="meta-label">Plan:</span> ${escapeHtml(planName || "Untitled")}</div>
      <div class="meta-row"><span class="meta-label">Strategy:</span> ${escapeHtml(strategyName)}</div>
      <div class="meta-row"><span class="meta-label">Date:</span> ${escapeHtml(dateStr)}</div>
      <div class="meta-row"><span class="meta-label">Time:</span> ${escapeHtml(timeStr)}</div>
    </div>

    <div class="sep"></div>

    <div class="section-head">Pre-Trade Checklist</div>
    ${itemsHtml || '<div class="item">No items yet.</div>'}

    <div class="footer">
      <span>Trading Manager · v0.1.0</span>
      <span>Generated ${escapeHtml(dateStr)} at ${escapeHtml(timeStr)}</span>
    </div>
    ${pageInnerClose}
  </div>
</body>
</html>`;
}


