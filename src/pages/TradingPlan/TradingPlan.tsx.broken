    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid ${border};
    margin-bottom: 24px;
  }
  .title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: ${fg};
  }
  .badge {
    margin-left: auto;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 999px;
    background: ${accentBg};
    color: ${accent};
    font-weight: 600;
  }
  .sub {
    font-size: 12px;
    color: ${fgMuted};
    margin-top: 3px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }
  .stat {
    padding: 12px 14px;
    background: ${dark ? "#161d26" : "#f8fafc"};
    border-radius: 8px;
  }
  .stat-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: ${fgDim};
    margin-bottom: 4px;
  }
  .stat-value {
    font-size: 13px;
