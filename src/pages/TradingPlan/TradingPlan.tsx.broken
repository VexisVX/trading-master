      <div class="stat"><div class="stat-label">Entry</div><div class="stat-value"></div></div>
      <div class="stat"><div class="stat-label">Stop</div><div class="stat-value"></div></div>
      <div class="stat"><div class="stat-label">Target</div><div class="stat-value"></div></div>
      <div class="stat"><div class="stat-label">R:R Planned</div><div class="stat-value"></div></div>
      <div class="stat"><div class="stat-label">R Realized</div><div class="stat-value"></div></div>
      <div class="stat"><div class="stat-label">Outcome</div><div class="stat-value"></div></div>
    </div>

    <div class="section-title">Pre-Trade Checklist</div>
    ${itemsHtml || '<div class="item">No items</div>'}

    <div class="section-title">Notes</div>
    <div class="notes"></div>

    <div class="footer">
      Generated ${escapeHtml(new Date().toLocaleDateString())} · Trading Manager v0.1.0
    </div>
  </div>
</body>
</html>`;
  }

  // ---- HYBRID style: modern with gradient ----
  const bg = dark ? "#11161d" : "#ffffff";
  const bgOuter = dark ? "#0b0f14" : "#f8fafc";
  const fg = dark ? "#e6edf3" : "#0f172a";
  const fgMuted = dark ? "#9aa7b4" : "#475569";
  const fgDim = dark ? "#6b7886" : "#94a3b8";
  const border = dark ? "#232c38" : "#e2e8f0";

  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>${escapeHtml(planName || "Trading Plan")}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
    background: ${bgOuter};
    color: ${fg};
    padding: 32px 16px;
    line-height: 1.5;
  }
  .page {
    max-width: 860px;
    margin: 0 auto;
    background: ${bg};
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,0.15);
