    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    margin-bottom: 5px;
    border-radius: 8px;
    font-size: 13px;
    background: ${dark ? "#0f151c" : "#f8fafc"};
    border-left: 3px solid ${accent};
  }
  .item.is-checked {
    border-left-color: ${fgDim};
    opacity: 0.65;
  }
  .item.is-checked .text { text-decoration: line-through; }
  .check {
    width: 18px;
    height: 18px;
    border: 1.5px solid ${border};
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
