use super::DbError;
use crate::domain::strategy::*;
use rusqlite::{params, Connection, OptionalExtension};


fn save_version_snapshot(
    conn: &Connection,
    strategy_id: i64,
    version: i64,
    name: &str,
    description: Option<&str>,
    timeframes: &[StrategyTimeframe],
) -> Result<(), DbError> {
    let json = serde_json::to_string(timeframes)
        .map_err(|_| DbError::Sqlite(rusqlite::Error::InvalidQuery))?;
    let now = chrono::Utc::now().to_rfc3339();
    conn.execute(
        "INSERT INTO strategy_versions (strategy_id, version, name, description, timeframes_json, created_at)
         VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
        params![strategy_id, version, name, description, json, now],
    )?;
    Ok(())
}

pub fn list_versions(
    conn: &Connection, strategy_id: i64,
) -> Result<Vec<(i64, i64, String, Option<String>, String)>, DbError> {
    let mut stmt = conn.prepare(
        "SELECT version, id, name, description, created_at FROM strategy_versions
         WHERE strategy_id=?1 ORDER BY version DESC"
    )?;
    let rows = stmt.query_map([strategy_id], |r| Ok((
        r.get::<_, i64>(0)?,
        r.get::<_, i64>(1)?,
        r.get::<_, String>(2)?,
        r.get::<_, Option<String>>(3)?,
        r.get::<_, String>(4)?,
    )))?;
    let mut out = Vec::new();
    for row in rows { out.push(row?); }
    Ok(out)
}

pub fn get_version_json(
    conn: &Connection, version_id: i64,
) -> Result<Option<String>, DbError> {
    use rusqlite::OptionalExtension;
    conn.query_row(
        "SELECT timeframes_json FROM strategy_versions WHERE id=?1",
        [version_id],
        |r| r.get(0),
    ).optional().map_err(Into::into)
}

pub fn create_strategy(conn: &Connection, s: &NewStrategy) -> Result<i64, DbError> {
    if s.name.trim().is_empty() {
        return Err(DbError::Sqlite(rusqlite::Error::InvalidQuery));
    }
    let now = chrono::Utc::now().to_rfc3339();

    // Phase 1: INSERT strategy + timeframes in a transaction
    let tx = conn.unchecked_transaction()?;
    tx.execute(
        "INSERT INTO strategies (name, description, version, is_active, created_at, updated_at)
         VALUES (?1, ?2, 1, 1, ?3, ?3)",
        params![s.name, s.description, now],
    )?;
    let strategy_id = tx.last_insert_rowid();

    for (i, tf) in s.timeframes.iter().enumerate() {
        let fields_json = serde_json::to_string(&tf.fields)
            .map_err(|_| DbError::Sqlite(rusqlite::Error::InvalidQuery))?;
        tx.execute(
            "INSERT INTO strategy_timeframes (strategy_id, timeframe, fields_json, order_index)
             VALUES (?1, ?2, ?3, ?4)",
            params![strategy_id, tf.timeframe, fields_json, i as i64],
        )?;
    }
    tx.commit()?;

    // Phase 2: snapshot is BEST-EFFORT — failure does not roll back the strategy
    let _ = save_version_snapshot(conn, strategy_id, 1, &s.name, s.description.as_deref(), &s.timeframes);

    Ok(strategy_id)
}

pub fn get_strategy(conn: &Connection, id: i64) -> Result<Option<Strategy>, DbError> {
    let row = conn.query_row(
        "SELECT id, name, description, version, is_active, created_at, updated_at
         FROM strategies WHERE id=?1",
        [id],
        |r| Ok((
            r.get::<_, i64>(0)?, r.get::<_, String>(1)?,
            r.get::<_, Option<String>>(2)?, r.get::<_, i64>(3)?,
            r.get::<_, i64>(4)?, r.get::<_, String>(5)?, r.get::<_, String>(6)?,
        )),
    ).optional()?;

    let Some((sid, name, description, version, active, created, updated)) = row else {
        return Ok(None);
    };

    let mut stmt = conn.prepare(
        "SELECT timeframe, fields_json FROM strategy_timeframes
         WHERE strategy_id=?1 ORDER BY order_index",
    )?;
    let rows = stmt.query_map([sid], |r| {
        Ok((r.get::<_, String>(0)?, r.get::<_, String>(1)?))
    })?;

    let mut timeframes = Vec::new();
    for row in rows {
        let (tf_name, fields_s) = row?;
        let fields: Vec<StrategyField> =
            serde_json::from_str(&fields_s).unwrap_or_default();
        timeframes.push(StrategyTimeframe { timeframe: tf_name, fields });
    }

    Ok(Some(Strategy {
        id: sid,
        name,
        description,
        version,
        is_active: active != 0,
        created_at: created,
        updated_at: updated,
        timeframes,
    }))
}

pub fn list_strategies(conn: &Connection) -> Result<Vec<Strategy>, DbError> {
    let mut stmt = conn.prepare("SELECT id FROM strategies ORDER BY id DESC")?;
    let ids: Vec<i64> = stmt.query_map([], |r| r.get(0))?
        .collect::<Result<_, _>>()?;
    let mut out = Vec::with_capacity(ids.len());
    for id in ids {
        if let Some(s) = get_strategy(conn, id)? { out.push(s); }
    }
    Ok(out)
}

/// Replace a strategy's name, description, and timeframes.
/// Bumps `version` and updates `updated_at`.
pub fn update_strategy(conn: &Connection, id: i64, s: &NewStrategy) -> Result<(), DbError> {
    if s.name.trim().is_empty() {
        return Err(DbError::Sqlite(rusqlite::Error::InvalidQuery));
    }
    let now = chrono::Utc::now().to_rfc3339();

    let tx = conn.unchecked_transaction()?;

    let affected = tx.execute(
        "UPDATE strategies
         SET name=?1, description=?2, version=version+1, updated_at=?3
         WHERE id=?4",
        params![s.name, s.description, now, id],
    )?;
    if affected == 0 {
        return Err(DbError::Sqlite(rusqlite::Error::QueryReturnedNoRows));
    }

    tx.execute("DELETE FROM strategy_timeframes WHERE strategy_id=?1", [id])?;
    for (i, tf) in s.timeframes.iter().enumerate() {
        let fields_json = serde_json::to_string(&tf.fields)
            .map_err(|_| DbError::Sqlite(rusqlite::Error::InvalidQuery))?;
        tx.execute(
            "INSERT INTO strategy_timeframes (strategy_id, timeframe, fields_json, order_index)
             VALUES (?1, ?2, ?3, ?4)",
            params![id, tf.timeframe, fields_json, i as i64],
        )?;
    }

    let new_version: i64 = tx.query_row(
        "SELECT version FROM strategies WHERE id=?1", [id], |r| r.get(0),
    )?;

    tx.commit()?;

    // Snapshot is best-effort
    let _ = save_version_snapshot(conn, id, new_version, &s.name, s.description.as_deref(), &s.timeframes);

    Ok(())
}

/// Delete a strategy and its timeframes explicitly.
///
/// We do NOT rely on `ON DELETE CASCADE` here: cascade behavior depends on
/// `PRAGMA foreign_keys` being ON at the exact moment of the DELETE, which
/// is easy to break (in-memory test DBs, migration paths, backup/restore).
/// An explicit two-step delete is portable and self-documenting.
pub fn delete_strategy(conn: &Connection, id: i64) -> Result<(), DbError> {
    let tx = conn.unchecked_transaction()?;
    tx.execute("DELETE FROM strategy_timeframes WHERE strategy_id=?1", [id])?;
    tx.execute("DELETE FROM strategies WHERE id=?1", [id])?;
    tx.commit()?;
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;
    use rust_decimal::Decimal;
    use rust_decimal_macros::dec;
    use crate::db::trades as trades_db;
    use crate::domain::trade::*;

    fn fresh_db() -> Connection {
        let conn = Connection::open_in_memory().unwrap();
        conn.execute_batch("PRAGMA foreign_keys = ON;").unwrap();
        conn.execute_batch(
            "CREATE TABLE accounts (id INTEGER PRIMARY KEY, name TEXT, currency TEXT, initial_balance TEXT, is_active INTEGER, kind TEXT DEFAULT 'personal', created_at TEXT);
             INSERT INTO accounts VALUES (1,'T','USD','10000',1,'personal','2026-01-01');
             CREATE TABLE trades (
               id INTEGER PRIMARY KEY AUTOINCREMENT,
               account_id INTEGER, symbol TEXT, side TEXT,
               entry_price TEXT, initial_stop TEXT, take_profit TEXT,
               total_quantity TEXT, outcome TEXT DEFAULT 'open',
               size_type TEXT DEFAULT 'lots', size_value TEXT, size_unit TEXT,
               manual_pnl TEXT,
               status TEXT, strategy_id INTEGER,
               opened_at TEXT, closed_at TEXT, notes TEXT,
               chart_url TEXT, screenshot_path TEXT,
               created_at TEXT, updated_at TEXT
             );
             CREATE TABLE trade_legs (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_id INTEGER, kind TEXT, price TEXT, quantity TEXT, executed_at TEXT, cost_per_unit TEXT DEFAULT '0');
             CREATE TABLE trade_tags (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_id INTEGER, tag TEXT);
             CREATE TABLE trade_attachments (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_id INTEGER, filename TEXT, kind TEXT, created_at TEXT);
             CREATE TABLE strategies (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, description TEXT, version INTEGER DEFAULT 1, is_active INTEGER DEFAULT 1, created_at TEXT, updated_at TEXT);
             CREATE TABLE strategy_timeframes (id INTEGER PRIMARY KEY AUTOINCREMENT, strategy_id INTEGER, timeframe TEXT, fields_json TEXT, order_index INTEGER);",
        ).unwrap();
        conn
    }

    fn sample_strategy() -> NewStrategy {
        NewStrategy {
            name: "ICT Silver Bullet".into(),
            description: Some("Liquidity + POI".into()),
            timeframes: vec![
                StrategyTimeframe {
                    timeframe: "4H".into(),
                    fields: vec![
                        StrategyField {
                            key: "bias".into(), label: "Bias".into(),
                            kind: FieldType::Select,
                            options: vec!["Bullish".into(), "Bearish".into(), "Neutral".into()],
                            required: true,
                        },
                        StrategyField {
                            key: "notes".into(), label: "Notes".into(),
                            kind: FieldType::Textarea,
                            options: vec![],
                            required: false,
                        },
                    ],
                },
                StrategyTimeframe {
                    timeframe: "5M".into(),
                    fields: vec![StrategyField {
                        key: "entry".into(), label: "Entry confirm".into(),
                        kind: FieldType::Text, options: vec![], required: true,
                    }],
                },
            ],
        }
    }

    fn sample_new_trade(strategy_id: Option<i64>) -> NewTrade {
        NewTrade {
            account_id: 1,
            symbol: "EURUSD".into(),
            side: Side::Long,
            entry_price: dec!(1.1),
            initial_stop: dec!(1.09),
            take_profit: None,
            total_quantity: dec!(1),
            size_type: SizeType::Lots,
            size_value: Some(dec!(1)),
            size_unit: None,
            opened_at: "2026-10-20T10:00:00Z".into(),
            notes: None,
            chart_url: None,
            screenshot_path: None,
            strategy_id,
            entry_legs: vec![NewLeg {
                price: dec!(1.1),
                quantity: dec!(1),
                cost_per_unit: Decimal::ZERO,
            }],
            tags: vec![],
        }
    }

    #[test]
    fn create_and_read_round_trip() {
        let conn = fresh_db();
        let id = create_strategy(&conn, &sample_strategy()).unwrap();
        let s = get_strategy(&conn, id).unwrap().unwrap();
        assert_eq!(s.name, "ICT Silver Bullet");
        assert_eq!(s.timeframes.len(), 2);
        assert_eq!(s.timeframes[0].timeframe, "4H");
        assert_eq!(s.timeframes[1].timeframe, "5M");
    }

    #[test]
    fn rejects_empty_name() {
        let conn = fresh_db();
        let mut s = sample_strategy();
        s.name = "  ".into();
        assert!(create_strategy(&conn, &s).is_err());
    }

    #[test]
    fn list_returns_in_descending_order() {
        let conn = fresh_db();
        let a = create_strategy(&conn, &sample_strategy()).unwrap();
        let b = create_strategy(&conn, &sample_strategy()).unwrap();
        let list = list_strategies(&conn).unwrap();
        assert_eq!(list[0].id, b);
        assert_eq!(list[1].id, a);
    }

    #[test]
    fn delete_removes_timeframes_explicitly() {
        let conn = fresh_db();
        let id = create_strategy(&conn, &sample_strategy()).unwrap();
        let before: i64 = conn.query_row(
            "SELECT COUNT(*) FROM strategy_timeframes WHERE strategy_id=?1",
            [id], |r| r.get(0),
        ).unwrap();
        assert_eq!(before, 2);
        delete_strategy(&conn, id).unwrap();
        let after: i64 = conn.query_row(
            "SELECT COUNT(*) FROM strategy_timeframes WHERE strategy_id=?1",
            [id], |r| r.get(0),
        ).unwrap();
        assert_eq!(after, 0);
    }

    #[test]
    fn trade_links_to_strategy() {
        let conn = fresh_db();
        let sid = create_strategy(&conn, &sample_strategy()).unwrap();
        let t = sample_new_trade(Some(sid));
        let tid = trades_db::create_trade(&conn, &t).unwrap();
        let stored: Option<i64> = conn.query_row(
            "SELECT strategy_id FROM trades WHERE id=?1", [tid], |r| r.get(0),
        ).unwrap();
        assert_eq!(stored, Some(sid));
    }

    #[test]
    fn update_replaces_fields_and_bumps_version() {
        let conn = fresh_db();
        let id = create_strategy(&conn, &sample_strategy()).unwrap();
        let before = get_strategy(&conn, id).unwrap().unwrap();
        assert_eq!(before.version, 1);

        let mut updated = sample_strategy();
        updated.name = "Renamed Strategy".into();
        updated.timeframes = vec![StrategyTimeframe {
            timeframe: "15M".into(),
            fields: vec![StrategyField {
                key: "confirm".into(), label: "Confirmation".into(),
                kind: FieldType::Text, options: vec![], required: true,
            }],
        }];

        update_strategy(&conn, id, &updated).unwrap();
        let after = get_strategy(&conn, id).unwrap().unwrap();
        assert_eq!(after.name, "Renamed Strategy");
        assert_eq!(after.version, 2);
        assert_eq!(after.timeframes.len(), 1);
    }

    #[test]
    fn update_unknown_id_fails() {
        let conn = fresh_db();
        assert!(update_strategy(&conn, 999, &sample_strategy()).is_err());
    }

    #[test]
    fn update_rejects_empty_name() {
        let conn = fresh_db();
        let id = create_strategy(&conn, &sample_strategy()).unwrap();
        let mut bad = sample_strategy();
        bad.name = "   ".into();
        assert!(update_strategy(&conn, id, &bad).is_err());
    }
}

